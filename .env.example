# ============================================================
# ROOT ENV — infra-shared values ONLY.
# Do NOT add service-specific vars here. Each service owns its
# own .env.example under services/<name>/.env.example
# Owner of this file: whoever owns infra/ (see TEAM_OWNERSHIP.md)
# ============================================================

COMPOSE_PROJECT_NAME=netaudit
NETWORK_NAME=audit-net

# --- Postgres (shared datastore, several services connect) ---
POSTGRES_USER=netaudit
POSTGRES_PASSWORD=changeme_in_local_env
POSTGRES_DB=netaudit
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis (Celery broker) ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- MinIO ---
MINIO_ROOT_USER=netaudit_minio
MINIO_ROOT_PASSWORD=changeme_in_local_env
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- ChromaDB ---
CHROMADB_HOST=chromadb
CHROMADB_PORT=8000

# --- OPA ---
OPA_HOST=opa
OPA_PORT=8181

# --- Ollama ---
OLLAMA_HOST=ollama
OLLAMA_PORT=11434
OLLAMA_MODEL=qwen2.5-coder:7b

# --- Batfish ---
BATFISH_HOST=batfish
BATFISH_PORT=9997

# --- Neo4j (GraphRAG topology graph, Compliance lane) ---
NEO4J_HOST=neo4j
NEO4J_BOLT_PORT=7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme_in_local_env
# Consumed directly by the neo4j image to set the same credentials above.
NEO4J_AUTH=neo4j/changeme_in_local_env

# --- Gateway / nginx ---
NGINX_PORT=443
GATEWAY_PORT=8000
FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_USE_MOCK_API=false
JWT_SECRET=changeme_generate_a_real_secret
JWT_ALGORITHM=HS256
