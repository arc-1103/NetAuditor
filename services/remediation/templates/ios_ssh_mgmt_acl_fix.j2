! CIS-IOS-1.1.3 - Restrict VTY access to the management network
! REVIEW: confirm {{ management_network | default('10.0.0.0') }} {{ management_wildcard | default('0.0.0.255') }} before deployment
configure terminal
ip access-list standard {{ management_acl | default('NETAUDIT-MGMT') }}
 permit {{ management_network | default('10.0.0.0') }} {{ management_wildcard | default('0.0.0.255') }}
 deny any log
exit
line vty 0 15
 access-class {{ management_acl | default('NETAUDIT-MGMT') }} in
 transport input ssh
end
write memory

