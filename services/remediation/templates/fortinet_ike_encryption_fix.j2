! CIS-FORTIOS-1.3.1 - Replace weak IPsec Phase 1 encryption
! REVIEW: confirm {{ vpn_name | default('vpn1') }} before deployment
config vpn ipsec phase1-interface
    edit "{{ vpn_name | default('vpn1') }}"
        set proposal aes256-sha256
        set dhgrp 14
    next
end
@@ROLLBACK@@
! Rollback: restores the pre-fix state (re-introduces the finding)
! REVIEW: restore the original proposal from the pre-change backup; these are common legacy values
config vpn ipsec phase1-interface
    edit "{{ vpn_name | default('vpn1') }}"
        set proposal 3des-sha1
        set dhgrp 5
    next
end
