# Owner: Remediation/Reporting lane (see TEAM_OWNERSHIP.md)
BATFISH_HOST=batfish
BATFISH_PORT=9997
TEMPLATE_DIR=/app/templates
APPROVAL_TIMEOUT_MIN=30
POSTGRES_DSN=postgresql+asyncpg://netaudit:changeme_in_local_env@postgres:5432/netaudit
# Set to true to skip real Batfish container during local template dev.
USE_MOCK_BATFISH=true

# Agentic RAG remediation fallback (app/rag_remediation.py) — used only when
# a finding's vendor has no committed .j2 template. Every other remediation
# stays on the deterministic template_engine.py path; see README.md's
# Safety Model section.
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M
# Defaults to false, unlike Parsing's USE_MOCK_SLM: this service's mock
# (app/slm_client.py) returns a fixed placeholder string regardless of the
# finding, and persisting that as a real operator-facing proposal in the
# default stack would be actively misleading. Set to true only for local
# dev/tests without a real Ollama — an unconfigured Ollama should otherwise
# fail the request (502), not silently produce fake CLI.
USE_MOCK_SLM=false
# Learning's remediation-manual index (services/learning/backend/app/main.py
# `/learning/remediation-manuals/search`). Unset means no manual context is
# ever found — the fallback still runs, marked ungrounded.
LEARNING_URL=http://learning:8003
