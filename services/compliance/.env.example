# Owner: Compliance/OPA lane (see TEAM_OWNERSHIP.md)
# Only vars this service reads. Values reference root .env at compose level.

# Base of OPA's data API. app/opa_client.py appends /compliance/<framework>.
OPA_URL=http://opa:8181/v1/data
OPA_TIMEOUT_SECONDS=10

# Framework used when a job/request doesn't name one. CIS | NIST | STIG.
DEFAULT_FRAMEWORK=CIS

# Where the opa container mounts services/compliance/policies (see
# docker-compose.yml). Read by humans and the healthcheck, not by app code —
# this service never touches the .rego files itself, it only queries OPA.
POLICY_BUNDLE_PATH=/policies

POSTGRES_DSN=postgresql+asyncpg://netaudit:changeme_in_local_env@postgres:5432/netaudit

# Broker for the `compliance.evaluate_baseline` task from the Parsing lane.
CELERY_BROKER_URL=redis://redis:6379/0
