# Owner: Parsing/SLM lane (see TEAM_OWNERSHIP.md)
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M
SCHEMA_PACKAGE_VERSION=1.0.0
CONFIDENCE_THRESHOLD=0.60
CHROMADB_HOST=chromadb
CHROMADB_PORT=8000
MAX_CHUNK_LINES=500
# Compatibility setting retained for the architecture vocabulary. Remote
# Ollama structured output is enforced through its `format` JSON-schema field;
# Outlines is not imported to control a remote decoder.
GRAMMAR_ENGINE=outlines
# Set to true to develop/test without Ollama. Mock mode still runs the full
# parse -> normalize -> validate -> merge -> confidence/gate pipeline.
USE_MOCK_SLM=true
# Shared with Ingestion/Compliance through the Redis lane boundary.
CELERY_BROKER_URL=redis://redis:6379/0
OLLAMA_TIMEOUT_SECONDS=60
# Written to when a job comes back human_review and never reaches Compliance —
# see services/parsing/app/db.py.
POSTGRES_DSN=postgresql+asyncpg://netaudit:changeme_in_local_env@postgres:5432/netaudit
# Semantic vendor-guess lookup when regex detection returns unknown — see
# services/parsing/app/vendor_fingerprint.py. Optional: a ChromaDB/Learning
# outage just means the human_review record has no semantic guess attached.
LEARNING_URL=http://learning:8003
# Corrective RAG grading for confirmed mappings handed to the SLM as
# few-shot context — see services/parsing/app/rag.py. A match this close is
# trusted outright; a match beyond RAG_AMBIGUOUS_MAX_DISTANCE is dropped; a
# match in between is trusted only if its cli_pattern literally appears in
# the chunk being parsed.
RAG_CORRECT_MAX_DISTANCE=0.4
RAG_AMBIGUOUS_MAX_DISTANCE=0.8
# Active learning via token uncertainty: when Ollama reports per-token
# logprobs for a chunk's generated JSON, a mean below this threshold routes
# the chunk to human review through the same Learning-lane unknown-block
# queue a validation failure uses, instead of publishing a baseline the
# model itself wasn't confident about. Chunks with no logprob signal at all
# (older Ollama versions, USE_MOCK_SLM's synthesized value aside) are not
# gated — see services/parsing/app/slm_client.py.
LOGPROB_UNCERTAINTY_THRESHOLD=-0.5
# Multi-agent reverse translation: a second SLM call (Agent B) reconstructs
# CLI from only the normalized JSON candidate, a third re-extracts JSON from
# that reconstruction, and the two candidates are diffed — see
# services/parsing/app/reverse_translation.py. A fidelity below this
# threshold routes the chunk to human review the same way the logprob gate
# does. Roughly triples SLM calls per chunk; set ENABLE_REVERSE_TRANSLATION
# to false to disable without a code change.
ENABLE_REVERSE_TRANSLATION=true
REVERSE_TRANSLATION_FIDELITY_THRESHOLD=0.7
# Exact-hash parse cache: a byte-identical (up to whitespace) [vendor, os,
# chunk text] skips RAG + SLM entirely on repeat — see
# services/parsing/app/parse_cache.py. Separate Redis logical DB from the
# Celery broker (db 0) so a cache flush can never touch queued messages.
ENABLE_PARSE_CACHE=true
PARSE_CACHE_REDIS_URL=redis://redis:6379/1
