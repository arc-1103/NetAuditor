# Owner: Parsing/SLM lane (see TEAM_OWNERSHIP.md)
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=qwen2.5-coder:7b
SCHEMA_PACKAGE_VERSION=1.0.0
CONFIDENCE_THRESHOLD=0.60
CHROMADB_HOST=chromadb
CHROMADB_PORT=8500
MAX_CHUNK_LINES=500
# Compatibility setting retained for the architecture vocabulary. Remote
# Ollama structured output is enforced through its `format` JSON-schema field;
# Outlines is not imported to control a remote decoder.
GRAMMAR_ENGINE=outlines
# Set to true to develop/test without Ollama. Mock mode still runs the full
# parse -> normalize -> validate -> merge -> confidence/gate pipeline.
USE_MOCK_SLM=true
# Shared with Ingestion/Compliance through the Redis lane boundary.
CELERY_BROKER_URL=redis://redis:6379/0
OLLAMA_TIMEOUT_SECONDS=60
