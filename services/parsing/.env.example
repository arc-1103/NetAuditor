# Owner: Parsing/SLM lane (see TEAM_OWNERSHIP.md)
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=qwen2.5-coder:7b
SCHEMA_PACKAGE_VERSION=1.0.0
CONFIDENCE_THRESHOLD=0.60
CHROMADB_HOST=chromadb
CHROMADB_PORT=8500
MAX_CHUNK_LINES=500
GRAMMAR_ENGINE=outlines
# Set to true to run against a stub SLM instead of real Ollama —
# lets this service be developed without the full stack running.
USE_MOCK_SLM=true
