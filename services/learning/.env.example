# Owner: Learning/RAG lane (see TEAM_OWNERSHIP.md)
CHROMADB_HOST=chromadb
CHROMADB_PORT=8500
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
POSTGRES_DSN=postgresql+asyncpg://netaudit:changeme_in_local_env@postgres:5432/netaudit
MAPPING_UI_PORT=3100
RAG_TOP_K=5

# Broker for the `learning.receive_unknown_block` task from the Parsing lane.
CELERY_BROKER_URL=redis://redis:6379/0

# Unsupervised semantic anomaly detection (app/main.py's baseline-vectors
# endpoints). Below this many vendor+OS peers, an IsolationForest fit isn't
# statistically meaningful, so the check returns "insufficient_peers"
# rather than a fabricated verdict.
ANOMALY_MIN_PEER_COUNT=5
