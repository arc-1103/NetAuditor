# Owner: Ingestion lane (see TEAM_OWNERSHIP.md)
# Only vars this service reads. Values reference root .env at compose level.
CELERY_BROKER_URL=redis://redis:6379/0
POSTGRES_DSN=postgresql+asyncpg://netaudit:changeme_in_local_env@postgres:5432/netaudit
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=netaudit_minio
MINIO_SECRET_KEY=changeme_in_local_env
MINIO_BUCKET=raw-configs
MINIO_SECURE=false
MAX_UPLOAD_SIZE_MB=10
ALLOWED_EXTENSIONS=.cfg,.txt,.conf
